node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
coverage/

# Runtime secrets. MAILMUX_DATA_DIR defaults to ~/.mailmux, outside the repo,
# but pointing it at a path in here must never publish the bearer token, the
# AES master key or the mail database.
.mailmux/
data/
bearer.token
master.key
master.salt
*.sqlite
*.sqlite3
*.db

# Next.js front end (apps/web keeps its own lockfile and its own install)
apps/web/.next/
apps/web/out/
apps/web/node_modules/

# `npm run web:sync` copies apps/web/out here for the self-hosted server.
web-next/

# Incremental tsc cache for `npm run desktop`
.tsbuildinfo
apps/web/.mailmux-export

# Desktop pack output and the copied server/UI tree
apps/desktop/release/
apps/desktop/server/

# Playwright MCP scratch
.playwright-mcp/

# Local agent fixtures (launch.json, worktrees)
.claude/
