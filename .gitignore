# No trailing slash, deliberately. `node_modules/` matches a directory only,
# so a SYMLINK named node_modules — what a worktree gets when somebody points
# it at another checkout's install — sails past it and can be committed. That
# happened once: the symlink reached master carrying an absolute path from one
# machine, and every clone after it had a broken node_modules that npm and
# Turbopack both refused. Without the slash this matches the name, whatever it
# is.
node_modules
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
coverage/

# Runtime secrets. The data dir is ~/.boxaide (or ~/.mailmux / ~/.sley on
# an old install). Pointing it at a path in here must never publish the
# bearer token, the AES master key or the mail database.
.boxaide/
.mailmux/
.sley/
data/
bearer.token
master.key
master.salt
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.p12
*.p8
*.mobileprovision

# Next.js front end (apps/web keeps its own lockfile and its own install)
apps/web/.next/
apps/web/out/
apps/web/node_modules

# `npm run web:sync` copies apps/web/out here for the self-hosted server.
web-next/

# Incremental tsc cache for `npm run desktop`
.tsbuildinfo
apps/web/.mailmux-export

# Desktop pack output and the copied server/UI tree
apps/desktop/release/
apps/desktop/server/

# Playwright MCP scratch
.playwright-mcp/

# Local agent fixtures (launch.json, worktrees)
.claude/*
!.claude/settings.json

# Local build stamp and personal agent workflows. The name follows the
# product; the two older ones are kept so an old checkout stays clean.
apps/web/.boxaide-export
apps/web/.sley-export
.grok/
